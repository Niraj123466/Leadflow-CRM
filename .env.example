# ---------------------------------------------------------------------------
# LeadFlow environment configuration
# Copy this file to `.env` (root, used by docker-compose) and/or
# `backend/.env` and `frontend/.env.local` for local (non-Docker) development.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
# Used by the `db` service in docker-compose.yml.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# SQLAlchemy connection URL. The psycopg (v3) driver is used.
# Local dev example: postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow
# Docker example:    postgresql+psycopg://leadflow:leadflow@db:5432/leadflow
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@localhost:5432/leadflow

# IANA timezone used to define "today" and "overdue" follow-ups.
APP_TIMEZONE=UTC

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Window (seconds) within which an identical discussion submission is treated
# as a duplicate and ignored (idempotency guard against double submits).
DISCUSSION_DEDUP_WINDOW_SECONDS=90

# Backend port for uvicorn (used by docker-compose only).
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# Base URL of the FastAPI backend as reachable from the browser.
# In docker-compose the browser calls the published backend port on localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
